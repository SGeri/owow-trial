generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordType {
  exercise
  commitment
  private_chat
}

enum RecordVisibility {
  exercise
  private_chat
}

enum CommitmentStatus {
  active
  completed
  superseded
}

model Member {
  id       String           @id
  sessions TrustedSession[]
  records  CoachingRecord[]
}

model TrustedSession {
  id        String      @id
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id])
  scenarios Scenario[]
  thread    ChatThread?

  @@index([memberId])
}

/// Exercise, commitment, or private-chat record from the coaching fixture.
model CoachingRecord {
  id         String            @id
  memberId   String
  member     Member            @relation(fields: [memberId], references: [id])
  type       RecordType
  visibility RecordVisibility
  week       Int
  text       String
  status     CommitmentStatus?
  replacedBy String?

  @@index([memberId])
  @@index([memberId, visibility])
  @@map("records")
}

model Scenario {
  id               String         @id
  trustedSessionId String
  trustedSession   TrustedSession @relation(fields: [trustedSessionId], references: [id])
  week             Int
  question         String
  answer           String

  @@index([trustedSessionId])
}

enum ChatMessageRole {
  user
  assistant
  system
}

/// One conversation per trusted session. Stores AI SDK UI messages, not plain text.
model ChatThread {
  id               String         @id @default(cuid())
  trustedSessionId String         @unique
  trustedSession   TrustedSession @relation(fields: [trustedSessionId], references: [id], onDelete: Cascade)
  messages         ChatMessage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ChatMessage {
  id        String          @id
  threadId  String
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ChatMessageRole
  parts     Json
  metadata  Json?
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
}
